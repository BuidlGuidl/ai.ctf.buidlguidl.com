# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLE_NAME
# You'll need to prefix the variable names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_PONDER_URL=

# Arena API origin. Defaults to http://localhost:4177 for local development.
NEXT_PUBLIC_ARENA_BACKEND_URL=

# Local dev only. Signs operator actions without a wallet prompt.
# Use Hardhat account 0, which the local chain profile registers as the seed funder,
# so one key both signs in and seeds a run:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Leave this empty to sign with a connected wallet. Never set it in production.
NEXT_PUBLIC_ARENA_DEV_SIGNER_KEY=

# Set to Y to serve the pilot-race marketing landing at /. Any other value (or unset)
# keeps the original agent-facing homepage.
NEXT_PUBLIC_MARKETING_LANDING=

# Which stage of race day the marketing landing shows: pre, live or post.
# Unset or unknown values mean pre.
NEXT_PUBLIC_MARKETING_PHASE=

# Arena run id whose final standings the landing shows in the post phase. Unset,
# the post-race landing keeps the roster.
NEXT_PUBLIC_MARKETING_RUN_ID=

# YouTube video id of the live stream: the 11 characters after "v=" in the video
# URL (https://www.youtube.com/watch?v=<id>), or after "/live/" in the link of a
# scheduled stream. Set, the landing embeds it in live and post; unset, it links
# to the channel and shows no player.
NEXT_PUBLIC_MARKETING_YOUTUBE_ID=

# Link to the X live: the broadcast URL, or the post that carries it. Set, the
# "watch on X" buttons and cards go there; unset, they go to Austin's profile.
NEXT_PUBLIC_MARKETING_X_LINK=
